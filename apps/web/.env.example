# Production builds use .env.production (committed). For `npm run dev`, copy this file to
# apps/web/.env.local (git ignores it) and fill in the same values to try sign-in locally.
# Firebase *web* config (Firebase console > Project settings > Your apps > Web app). These are
# public by design and end up in the browser bundle; they are not secrets. Never put a real
# secret in a VITE_* variable. Leave the key empty to run without admin sign-in.
# Proposal: variable names. Docker build args of the same names override .env.production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=comp523
# Optional; defaults to <project id>.firebaseapp.com. Changing it also means changing the
# frame-src host in security-headers.inc.
VITE_FIREBASE_AUTH_DOMAIN=
# Optional; only if the API is on another host. Same origin (/api) by default.
VITE_API_BASE_URL=
