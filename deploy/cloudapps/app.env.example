# Copy to app.env (git-ignored) and fill in. Not secret.
# Used by: oc process -f deploy/cloudapps/app.yaml --param-file=deploy/cloudapps/app.env | oc apply -f -
WEB_HOSTNAME=web-<project>.apps.cloudapps.unc.edu
# OpenAI transcription model id; check the current name before use.
TRANSCRIPTION_MODEL=
# Optional (defaults shown):
# GIT_URL=https://github.com/ege96/comp523-project
# GIT_REF=main
# TRANSCRIPTION_LANGUAGES=ne,en
# FIREBASE_PROJECT_ID=comp523
# Only for a project set up by hand before these templates (docs/deploy-cloudapps.md §3.7):
# DB_VOLUME_CLAIM=db-data
# GIT_SOURCE_SECRET=github-read
