# Copy to secrets.env (git-ignored), fill in, use once with setup.yaml, then delete it:
#   oc process -f deploy/cloudapps/setup.yaml --param-file=deploy/cloudapps/secrets.env | oc create -f -
# The database password, media-link key and webhook secrets are generated for you.
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
# Optional: only for TRANSCRIPTION_PROVIDER=mai.
# AZURE_SPEECH_KEY=
GITHUB_USERNAME=
GITHUB_TOKEN=
# Optional (defaults shown). Both count toward the project's storage quota.
# DB_VOLUME_SIZE=1Gi
# MEDIA_VOLUME_SIZE=4Gi
