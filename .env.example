# Copy to services/api/.env and services/worker/.env for local runs without Docker.
# Proposal: env var names are not yet agreed (see docs/decisions in the project bundle).
DATABASE_URL=postgresql://swayambhu@localhost:5432/swayambhu
# Firebase project whose sign-ins the API accepts (public; same value as the web app's
# VITE_FIREBASE_PROJECT_ID, see apps/web/.env.example).
# Leave empty to run without sign-in: admin endpoints then return 401/503.
FIREBASE_PROJECT_ID=comp523
# API logs: json (default, for OpenShift) or text (easier to read locally).
LOG_FORMAT=text

# AI providers (D-011..D-013), read by both the API and the worker (packages/providers).
# `fake` runs offline with no keys; use it for local dev. The API and worker must use the
# same embedding settings, or search won't find the worker's stored embeddings.
TRANSCRIPTION_PROVIDER=fake          # openai | elevenlabs | fake
TRANSCRIPTION_MODEL=                 # e.g. gpt-transcribe (verify current model id)
TRANSLATION_PROVIDER=fake            # google_nmt | fake
EMBEDDING_PROVIDER=fake              # openai | fake
EMBEDDING_MODEL=                     # e.g. text-embedding-3-large (verify current model id)
EMBEDDING_DIMENSIONS=                # optional; empty = the model's default size
# Secrets: only needed for the providers selected above. Never commit real values.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# API and worker: where recordings and playback copies are stored on disk (D-007, until a
# storage provider is chosen). Both must see the same files: one shared volume in CloudApps.
MEDIA_ROOT=./media
# API: signs the expiring links the player uses to stream media. Any long random string, the
# same on every API pod; leave empty locally (a random key per process is used). Secret.
MEDIA_URL_SECRET=
# API: largest recording an admin may upload, in bytes (default 10 GiB). Keep it below the
# media volume's free space. UPLOAD_CHUNK_MAX_BYTES caps one tus PATCH (default 64 MiB).
# MAX_UPLOAD_BYTES=10737418240
# UPLOAD_CHUNK_MAX_BYTES=67108864
# API and worker: unfinished uploads untouched this many days are deleted (default 3).
# UPLOAD_RETENTION_DAYS=3
# API: after an admin edits a line's original, re-translate edited lines this long after the
# last edit, so a burst of edits is one translation batch (default 300).
# RETRANSLATE_DELAY_SECONDS=300
