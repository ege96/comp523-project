# Copy to services/api/.env and services/worker/.env for local runs without Docker.
# Proposal: env var names are not yet agreed (see docs/decisions in the project bundle).
DATABASE_URL=postgresql://swayambhu@localhost:5432/swayambhu
# Firebase project whose sign-ins the API accepts (public; same value as the web config).
# Leave empty to run without sign-in: admin endpoints then return 401/503.
FIREBASE_PROJECT_ID=
